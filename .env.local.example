# Copy to .env.local; never commit keys or production passwords.
NEXT_PUBLIC_SITE_URL=https://aio-make.com
NEXT_PUBLIC_GA_ID=G-7R9P2N40RW
GA4_PROPERTY_ID=536780274
LOCAL_ADMIN_ENABLED=true
# Absolute persistent disk directory outside the Git checkout
LOCAL_DATA_DIR=I:/AIO_OS/01_WORK/00_공통운영/00_AIO 웹사이트/00_운영관리/문의관리
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Unique random secret, at least 32 characters
ADMIN_SESSION_SECRET=
# GA4 property Viewer role and Analytics Data API must be enabled.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM private key, escaped newlines accepted. Server-only.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Alternative: absolute server-only path to an existing service-account JSON file.
# Never put this file in public/ or commit it. Restart the server after configuration.
GOOGLE_APPLICATION_CREDENTIALS=

# Gmail OAuth web client; exact callback below. Server-only.
# http://127.0.0.1:3111/api/admin/google/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Same private random secret in local manager and production (32+ characters)
INQUIRY_SIGNING_SECRET=
# Production only: send-scoped refresh token. Read token stays on local disk.
GMAIL_SEND_REFRESH_TOKEN=
# Enable public intake after direct storage and admin acceptance
CONTACT_PUBLIC_ENABLED=false

# Direct website inquiries (Neon/PostgreSQL; separate from legacy Supabase)
# Use a dedicated database and its pooled TLS connection string.
INQUIRY_DATABASE_URL=
ADMIN_WEB_ENABLED=false
# Resend verified sender; fixed recipient aiomake2023@gmail.com
RESEND_API_KEY=
INQUIRY_EMAIL_FROM=
